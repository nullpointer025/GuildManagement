PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Officers must enter this code once when creating their account.
# Share it with your officers privately and change it whenever needed.
GUILD_INVITE_CODE=change-me
