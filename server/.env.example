PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign the access cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The single shared password for the whole site — there are no per-officer
# accounts. Everyone who wants in enters this code once (it's remembered for
# 30 days). Share it with your officers privately and change it any time to
# revoke access for everyone at once (they'll just need to re-enter the code).
GUILD_INVITE_CODE=change-me

# Optional: lets the Roster page's "Sync with Discord" button check who is in the
# guild's Discord server. Create a bot at https://discord.com/developers/applications,
# turn on "Server Members Intent", invite it to the server with the `bot` scope (no
# permissions needed), and paste its token plus the server ID here.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
