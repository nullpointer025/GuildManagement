PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase Postgres connection string. In the Supabase dashboard: Connect ->
# "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Long random string used to sign the access cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Unlocks the /admin page, where you create guilds and set each one's invite
# code. Every invite code opens only its own guild's roster, raids and leagues
# (no per-officer accounts). Changing ADMIN_CODE signs out every admin session.
ADMIN_CODE=change-me

# Optional: one bot shared by every guild for the Roster page's "Sync with Discord".
# Create a bot at https://discord.com/developers/applications and turn on "Server
# Members Intent". Each guild invites it to their server with the `bot` scope (no
# permissions needed) and enters their server ID under Guild settings (⚙ in the navbar).
DISCORD_BOT_TOKEN=
